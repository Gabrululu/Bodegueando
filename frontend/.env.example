# Arbitrum Sepolia RPC (also used server-side by the fiado-score API route)
NEXT_PUBLIC_ARBITRUM_SEPOLIA_RPC_URL=https://sepolia-rollup.arbitrum.io/rpc

# Upstash Redis (REST), para que los códigos de bodega/cliente y los vínculos de Telegram
# persistan de verdad en Vercel (su filesystem es efímero por invocación — sin esto, cada
# función serverless puede ver un .data/ vacío). Sin estas dos, la app cae de vuelta a un
# archivo JSON local — perfecto para desarrollo, no usable en producción. Cuenta gratis en
# https://console.upstash.com — crear una base Redis y copiar las credenciales REST.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Deployed contract addresses (fill in after running the deploy scripts — see root README)
NEXT_PUBLIC_PAYMENT_ROUTER_ADDRESS=
NEXT_PUBLIC_PUNTOS_TOKEN_ADDRESS=
NEXT_PUBLIC_FIADO_SCORING_ADDRESS=

# BeneficioToken.sol (PoC de programas sociales). Solo su owner puede issue() — hoy es la
# cuenta deployer de siempre; ver README para transferir el ownership a la smart account de
# quien vaya a operar la emisión desde el panel de bodega.
NEXT_PUBLIC_BENEFICIO_TOKEN_ADDRESS=

# InvoiceEscrow.sol (fiado con garantía parcial, opcional junto al fiado sin garantía de
# siempre). Necesita que FiadoScoring tenga seteado setEscrow(address) apuntando a esta
# dirección — ver README, sección "InvoiceEscrow".
NEXT_PUBLIC_INVOICE_ESCROW_ADDRESS=

# RewardsCatalog.sol (catálogo de beneficios canjeables por PUNTOS, propio de cada bodega,
# canjeable en cualquier bodega afiliada — no solo donde se ganaron los puntos). No necesita
# wiring en otros contratos, solo lee PaymentRouter.isBodega y gasta PUNTOS vía transferFrom
# — ver README, sección "RewardsCatalog".
NEXT_PUBLIC_REWARDS_CATALOG_ADDRESS=

# Anthropic API key for the /api/fiado-score AI credit-scoring route
ANTHROPIC_API_KEY=

# Testnet-only private key for the wallet authorized as FiadoScoring's ai_oracle.
# Hackathon shortcut: a real deployment should use a proper signer service, not a
# server-held key. Never fund this with anything but Arbitrum Sepolia test ETH.
ORACLE_PRIVATE_KEY=

# Telegram bot for payment notifications. Create the bot yourself via @BotFather in
# Telegram, put the token here (never commit it), and set the bot's @username (public,
# safe to share) so the UI can deep-link to it.
TELEGRAM_BOT_TOKEN=
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=

# Secreto propio (inventalo vos, cualquier string largo) que Telegram reenvía en el header
# X-Telegram-Bot-Api-Secret-Token en cada llamada al webhook (app/api/telegram/webhook) —
# así esa ruta puede rechazar pedidos que no vengan realmente de Telegram. Se pasa también
# al registrar el webhook con setWebhook (ver README).
TELEGRAM_WEBHOOK_SECRET=

# Chat de quien opera la app (no el de una bodega) — recibe la alerta de
# scripts/check-paymaster-balance.mjs cuando el depósito de gas está bajo. Para conseguirlo:
# hablale una vez al bot desde tu Telegram y mirá tu chat_id en
# frontend/.data/telegram-links.json (o en los logs de `pnpm run bot`).
TELEGRAM_ADMIN_CHAT_ID=

# Umbral, en ETH, bajo el cual scripts/check-paymaster-balance.mjs manda la alerta de arriba.
# Opcional — si no se setea, usa 0.01 por defecto.
PAYMASTER_BALANCE_ALERT_THRESHOLD_ETH=

# Twilio WhatsApp webhook (stub, lowest priority — WhatsApp Business API needs Meta
# permission approval, which is why Telegram shipped first)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=

# Privy (embedded wallets, login by phone/email — no browser wallet extension needed).
# Create an app at https://dashboard.privy.io, restrict login methods to email + SMS,
# and put the public App ID here.
NEXT_PUBLIC_PRIVY_APP_ID=

# Pimlico (ERC-4337 bundler for Arbitrum Sepolia). Create a free testnet API key at
# https://dashboard.pimlico.io. Public because it's used from the browser to submit
# UserOperations directly to the bundler.
NEXT_PUBLIC_PIMLICO_API_KEY=

# Deployed PuntosPaymaster.sol address (see root README "Contratos desplegados").
NEXT_PUBLIC_PUNTOS_PAYMASTER_ADDRESS=

# Testnet-only private key that deposits ETH into the ERC-4337 EntryPoint on behalf of
# PuntosPaymaster.sol, so users never need their own ETH for gas — their gas is instead
# billed in PUNTOS after their first (free) transaction. Never fund with anything but
# Arbitrum Sepolia test ETH; needs occasional manual top-up (cast send / forge script,
# not automated) once the EntryPoint deposit runs low — see PuntosPaymaster.sol.
PAYMASTER_FUNDING_PRIVATE_KEY=

# Testnet-only private key for app/api/faucet — sends a small amount of Arbitrum Sepolia
# ETH (the "eSol" stand-in) to a client's smart account the first time it's seen, so people
# probando la demo pueden pagar sin que alguien los fondee a mano. Never fund with anything
# but testnet ETH; needs occasional manual top-up once it runs low, same as
# PAYMASTER_FUNDING_PRIVATE_KEY.
FAUCET_PRIVATE_KEY=

# Monto en ETH que regala app/api/faucet por cuenta nueva. Opcional — si no se setea, usa
# 0.005 por defecto.
FAUCET_AMOUNT_ETH=
