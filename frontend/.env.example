# Arbitrum Sepolia RPC (also used server-side by the fiado-score API route)
NEXT_PUBLIC_ARBITRUM_SEPOLIA_RPC_URL=https://sepolia-rollup.arbitrum.io/rpc

# Deployed contract addresses (fill in after running the deploy scripts — see root README)
NEXT_PUBLIC_PAYMENT_ROUTER_ADDRESS=
NEXT_PUBLIC_PUNTOS_TOKEN_ADDRESS=
NEXT_PUBLIC_FIADO_SCORING_ADDRESS=

# Anthropic API key for the /api/fiado-score AI credit-scoring route
ANTHROPIC_API_KEY=

# Testnet-only private key for the wallet authorized as FiadoScoring's ai_oracle.
# Hackathon shortcut: a real deployment should use a proper signer service, not a
# server-held key. Never fund this with anything but Arbitrum Sepolia test ETH.
ORACLE_PRIVATE_KEY=

# Telegram bot for payment notifications. Create the bot yourself via @BotFather in
# Telegram, put the token here (never commit it), and set the bot's @username (public,
# safe to share) so the UI can deep-link to it.
TELEGRAM_BOT_TOKEN=
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=

# Twilio WhatsApp webhook (stub, lowest priority — WhatsApp Business API needs Meta
# permission approval, which is why Telegram shipped first)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=

# Privy (embedded wallets, login by phone/email — no browser wallet extension needed).
# Create an app at https://dashboard.privy.io, restrict login methods to email + SMS,
# and put the public App ID here.
NEXT_PUBLIC_PRIVY_APP_ID=

# Pimlico (ERC-4337 bundler for Arbitrum Sepolia). Create a free testnet API key at
# https://dashboard.pimlico.io. Public because it's used from the browser to submit
# UserOperations directly to the bundler.
NEXT_PUBLIC_PIMLICO_API_KEY=

# Deployed PuntosPaymaster.sol address (see root README "Contratos desplegados").
NEXT_PUBLIC_PUNTOS_PAYMASTER_ADDRESS=

# Testnet-only private key that deposits ETH into the ERC-4337 EntryPoint on behalf of
# PuntosPaymaster.sol, so users never need their own ETH for gas — their gas is instead
# billed in PUNTOS after their first (free) transaction. Never fund with anything but
# Arbitrum Sepolia test ETH; needs occasional manual top-up (cast send / forge script,
# not automated) once the EntryPoint deposit runs low — see PuntosPaymaster.sol.
PAYMASTER_FUNDING_PRIVATE_KEY=
